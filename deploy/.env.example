# Stumped backend — production env for the VPS.
# Copy to `.env` in this directory and fill in. The real .env is git-ignored.

# --- Database ---
# Create the DB + scoped user on the VPS first:
#   cd /srv/infra && ./scripts/create-app-db.sh stumped
# then build the URL from its output (host is the shared MySQL service name):
#   mysql://<DB_USERNAME>:<DB_PASSWORD>@mysql:3306/<DB_NAME>
DATABASE_URL="mysql://stumped:CHANGE_ME@mysql:3306/stumped"

# --- Auth ---
# Generate a fresh production secret:  openssl rand -hex 32
JWT_SECRET="CHANGE_ME_64_HEX"

# Google OAuth WEB client ID — used to verify Google ID tokens from the app.
GOOGLE_CLIENT_ID="196252220000-n59qb6e7pbpc5dkvmbk32skhlc9ldvu7.apps.googleusercontent.com"

# --- CORS ---
# The public web origin(s), comma-separated. Native mobile is not affected.
CORS_ORIGIN="https://stumped.adkdev.in"

# --- Server ---
PORT=3005
NODE_ENV=production
